<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/gl_add_hub_bluetooth_connect_vertical"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.5" />

    <TextView
        android:id="@+id/tv_add_hub_bluetooth_connect_title"
        style="@style/TextAppearance.Title1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/connect_to_bluetooth_title"
        android:textColor="@color/Gray800"
        android:layout_marginStart="@dimen/spacing4"
        android:layout_marginTop="76dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />
    
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/container_add_hub_bluetooth_connect"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing5"
        android:layout_marginHorizontal="@dimen/spacing4"
        android:background="@drawable/rectangle_radius_12dp"
        android:backgroundTint="@color/Gray100"
        app:layout_constraintTop_toBottomOf="@+id/tv_add_hub_bluetooth_connect_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tv_add_hub_bluetooth_connect_on"
            style="@style/TextAppearance.SubTitle1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginVertical="@dimen/spacing9"
            android:layout_marginStart="@dimen/spacing5"
            android:text="@string/connect_to_bluetooth_on"
            android:textColor="@color/Gray900"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageButton
            android:id="@+id/ib_add_hub_bluetooth_connect_on"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_bluetooth_24dp"
            android:contentDescription="@string/connect_to_bluetooth_content_description"
            android:background="@drawable/circle_image_background"
            android:backgroundTint="@color/white"
            android:padding="@dimen/padding_xs"
            android:layout_marginEnd="@dimen/spacing5"
            app:layout_constraintBottom_toBottomOf="@+id/tv_add_hub_bluetooth_connect_on"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tv_add_hub_bluetooth_connect_on"
            app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.App.CornerSize50Percent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_add_hub_bluetooth_connect_previous"
        style="@style/Theme.ElderCare.Button.Capsule"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/white"
        android:text="@string/input_name_previous_btn"
        android:textAppearance="@style/TextAppearance.SubTitle5"
        android:textColor="@color/primary"
        android:singleLine="true"
        android:paddingVertical="@dimen/padding_m"
        android:layout_marginStart="@dimen/spacing4"
        android:layout_marginEnd="6dp"
        android:layout_marginBottom="@dimen/spacing4"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/gl_add_hub_bluetooth_connect_vertical"
        app:layout_constraintStart_toStartOf="parent"
        app:strokeColor="@color/primary"
        app:strokeWidth="1dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_add_hub_bluetooth_connect_next"
        style="@style/Theme.ElderCare.Button.L"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/primary"
        android:text="@string/input_name_next_btn"
        android:textAppearance="@style/TextAppearance.SubTitle5"
        android:textColor="@color/white"
        android:singleLine="true"
        android:paddingVertical="@dimen/padding_m"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="@dimen/spacing4"
        android:layout_marginBottom="@dimen/spacing4"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/gl_add_hub_bluetooth_connect_vertical" />

</androidx.constraintlayout.widget.ConstraintLayout>
