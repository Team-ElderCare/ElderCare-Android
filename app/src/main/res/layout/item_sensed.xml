<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:padding="@dimen/spacing2"
    android:layout_height="wrap_content">

    <TextView
        android:id="@+id/textView18"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="item_normal" />

    <TextView
        android:id="@+id/tv_sensed_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="오전 08:00"
        android:textAppearance="@style/TextAppearance.Body6"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_device_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing10"
        android:text="태그"
        android:textAppearance="@style/TextAppearance.Body6"
        app:layout_constraintStart_toEndOf="@+id/tv_sensed_time"
        app:layout_constraintTop_toTopOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
