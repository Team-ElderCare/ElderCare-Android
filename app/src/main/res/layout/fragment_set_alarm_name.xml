<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:layout_marginStart="@dimen/spacing3"
        android:id="@+id/textView5"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing13"
        android:padding="@dimen/spacing3"
        android:text="복용 알람 이름을 설정해주세요."
        android:textAppearance="@style/TextAppearance.Title1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/textView7"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing3"
        android:padding="@dimen/spacing3"
        android:layout_marginTop="@dimen/spacing5"
        android:text="복용 알람 이름 설정"
        android:textAppearance="@style/TextAppearance.SubTitle3"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView5" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/textFieldLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:errorEnabled="true"
        app:boxCornerRadiusBottomStart="@dimen/spacing6"
        app:boxCornerRadiusTopEnd="@dimen/spacing6"
        app:boxCornerRadiusTopStart="@dimen/spacing6"
        app:boxCornerRadiusBottomEnd="@dimen/spacing6"
        app:boxStrokeColor="@color/secondary_02"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:hint="치료하는 질병 기준으로 설정해주세요"
        app:boxStrokeErrorColor="@color/sys_error_01"
        app:layout_constraintTop_toBottomOf="@+id/textView7">

        <com.google.android.material.textfield.TextInputEditText
            android:background="@drawable/rectangle_green_with_stroke"
            android:id="@+id/textInputEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/spacing4"
            android:layout_marginTop="@dimen/spacing3"
            android:textColor="@color/Gray500"
            android:maxLines="1"
            android:padding="@dimen/spacing4"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/textView7" />


    </com.google.android.material.textfield.TextInputLayout>



    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_next"
        android:clickable="false"
        android:layout_marginHorizontal="@dimen/spacing4"
        android:layout_marginBottom="@dimen/spacing5"
        style="@style/Theme.ElderCare.Button.Capsule"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:enabled="true"
        android:text="다음으로"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
