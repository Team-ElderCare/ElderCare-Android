<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/gl_add_hub_connect_wifi_vertical"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.5" />

    <TextView
        android:id="@+id/tv_add_hub_connect_wifi_title"
        style="@style/TextAppearance.Title1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/connect_to_wifi_title"
        android:textColor="@color/Gray800"
        android:layout_marginTop="76dp"
        android:layout_marginStart="@dimen/spacing4"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <TextView
        android:id="@+id/tv_add_hub_connect_wifi_desc"
        style="@style/TextAppearance.SubTitle2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/connect_to_wifi_desc"
        android:textColor="@color/Gray900"
        android:singleLine="true"
        android:layout_marginTop="@dimen/spacing3"
        android:layout_marginBottom="@dimen/spacing3"
        android:layout_marginEnd="42dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_add_hub_connect_wifi_title"
        app:layout_constraintStart_toStartOf="@+id/tv_add_hub_connect_wifi_title"/>

    <TextView
        android:id="@+id/tv_add_hub_connect_wifi_name"
        style="@style/TextAppearance.Body2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textAlignment="center"
        android:textColor="@color/Gray500"
        android:layout_marginEnd="6dp"
        android:layout_marginTop="@dimen/spacing7"
        android:background="@drawable/rectangle_radius_stroke_32dp"
        android:paddingHorizontal="@dimen/spacing5"
        android:paddingVertical="@dimen/spacing4"
        app:layout_constraintEnd_toStartOf="@+id/gl_add_hub_connect_wifi_vertical"
        app:layout_constraintStart_toStartOf="@+id/tv_add_hub_connect_wifi_desc"
        app:layout_constraintTop_toBottomOf="@+id/tv_add_hub_connect_wifi_desc" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_add_hub_connect_wifi_list"
        style="@style/Theme.ElderCare.Button.L"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing4"
        android:layout_marginEnd="6dp"
        android:backgroundTint="@color/primary"
        android:paddingVertical="@dimen/padding_m"
        android:singleLine="true"
        android:text="@string/button_wifi_list"
        android:textAppearance="@style/TextAppearance.SubTitle5"
        android:textColor="@color/white"
        app:layout_constraintBottom_toBottomOf="@+id/tv_add_hub_connect_wifi_name"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/gl_add_hub_connect_wifi_vertical"
        app:layout_constraintTop_toTopOf="@+id/tv_add_hub_connect_wifi_name" />

    <com.example.eldercare.presentation.ui.custom.CustomEditText
        android:id="@+id/et_add_hub_connect_wifi_password"
        style="@style/TextAppearance.Body2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textColor="@color/Gray500"
        app:customHint="@string/connect_to_wifi_placeholder"
        android:textColorHint="@color/Gray500"
        android:layout_marginTop="@dimen/spacing3"
        app:layout_constraintEnd_toEndOf="@+id/btn_add_hub_connect_wifi_list"
        app:layout_constraintStart_toStartOf="@+id/tv_add_hub_connect_wifi_name"
        app:layout_constraintTop_toBottomOf="@+id/tv_add_hub_connect_wifi_name" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_add_hub_connect_wifi_previous"
        style="@style/Theme.ElderCare.Button.Capsule"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/white"
        android:text="@string/input_name_previous_btn"
        android:textAppearance="@style/TextAppearance.SubTitle5"
        android:textColor="@color/primary"
        android:singleLine="true"
        android:paddingVertical="@dimen/padding_m"
        android:layout_marginStart="@dimen/spacing4"
        android:layout_marginEnd="6dp"
        android:layout_marginBottom="@dimen/spacing4"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/gl_add_hub_connect_wifi_vertical"
        app:layout_constraintStart_toStartOf="parent"
        app:strokeColor="@color/primary"
        app:strokeWidth="1dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_add_hub_connect_wifi_next"
        style="@style/Theme.ElderCare.Button.L"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/primary"
        android:text="@string/input_name_next_btn"
        android:textAppearance="@style/TextAppearance.SubTitle5"
        android:textColor="@color/white"
        android:singleLine="true"
        android:paddingVertical="@dimen/padding_m"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="@dimen/spacing4"
        android:layout_marginBottom="@dimen/spacing4"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/gl_add_hub_connect_wifi_vertical" />

</androidx.constraintlayout.widget.ConstraintLayout>
