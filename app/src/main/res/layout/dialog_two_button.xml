<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/rectangle_radius_16dp"
        android:backgroundTint="@color/white">

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/gl_two_btn_dialog"
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.5" />

        <ImageView
            android:id="@+id/iv_two_btn_dialog_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing5"
            android:contentDescription="@string/two_button_dialog_image_desc"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_two_btn_dialog_title"
            style="@style/TextAppearance.Title6"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/Gray900"
            android:layout_marginHorizontal="@dimen/spacing9"
            android:layout_marginTop="@dimen/spacing4"
            app:layout_constraintTop_toBottomOf="@id/iv_two_btn_dialog_icon"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <TextView
            android:id="@+id/tv_two_btn_dialog_detail"
            style="@style/TextAppearance.Body5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/Gray400"
            android:layout_marginHorizontal="@dimen/spacing5"
            android:layout_marginTop="@dimen/spacing1"
            app:layout_constraintTop_toBottomOf="@id/tv_two_btn_dialog_title"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_two_btn_dialog_left"
            style="@style/Theme.ElderCare.Button.Dialog"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:backgroundTint="@color/white"
            android:textColor="@color/primary"
            app:strokeColor="@color/primary"
            app:strokeWidth="1dp"
            android:layout_marginStart="@dimen/spacing3"
            android:layout_marginEnd="@dimen/spacing1"
            android:layout_marginTop="@dimen/spacing3"
            android:layout_marginBottom="@dimen/spacing3"
            android:paddingVertical="@dimen/spacing3"
            android:maxLines="1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/gl_two_btn_dialog"
            app:layout_constraintTop_toBottomOf="@id/tv_two_btn_dialog_detail"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_two_btn_dialog_right"
            style="@style/Theme.ElderCare.Button.Dialog"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:layout_marginEnd="@dimen/spacing3"
            android:layout_marginStart="@dimen/spacing1"
            android:paddingVertical="@dimen/spacing3"
            android:maxLines="1"
            app:layout_constraintStart_toEndOf="@id/gl_two_btn_dialog"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="@id/btn_two_btn_dialog_left"
            app:layout_constraintTop_toTopOf="@id/btn_two_btn_dialog_left"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>
