<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/rectangle_radius_16dp"
        android:backgroundTint="@color/white">

        <ImageView
            android:id="@+id/iv_one_btn_dialog_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing5"
            android:contentDescription="@string/one_button_dialog_image_desc"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_one_btn_dialog_title"
            style="@style/TextAppearance.Title6"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/Gray900"
            android:layout_marginHorizontal="@dimen/spacing9"
            android:layout_marginTop="@dimen/spacing4"
            app:layout_constraintTop_toBottomOf="@id/iv_one_btn_dialog_icon"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <TextView
            android:id="@+id/tv_one_btn_dialog_detail"
            style="@style/TextAppearance.Body5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/Gray400"
            android:textAlignment="center"
            android:layout_marginHorizontal="@dimen/spacing5"
            android:layout_marginTop="@dimen/spacing1"
            app:layout_constraintTop_toBottomOf="@id/tv_one_btn_dialog_title"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_one_btn_dialog"
            style="@style/Theme.ElderCare.Button.Dialog"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:layout_marginHorizontal="@dimen/spacing3"
            android:layout_marginTop="@dimen/spacing4"
            android:layout_marginBottom="@dimen/spacing3"
            android:paddingVertical="@dimen/spacing3"
            android:maxLines="1"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_one_btn_dialog_detail"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>
