<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

    <include
        android:id="@+id/include_input_device_location_topbar"
        layout="@layout/view_all_topbar_arrow_with_title"
        text="@{@string/add_device_topbar}"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

        <include
            android:id="@+id/include_input_device_location_view_title_with_cg"
            layout="@layout/view_title_with_chip_group"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            title="@{@string/add_device_input_location_title}"
            description="@{@string/add_device_input_location_guide}"
            android:layout_marginTop="@dimen/spacing6"
            app:layout_constraintTop_toBottomOf="@id/include_input_device_location_topbar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_input_device_location_next"
            style="@style/Theme.ElderCare.Button.L"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/input_location_next_btn"
            android:paddingVertical="@dimen/padding_m"
            android:layout_marginBottom="@dimen/spacing4"
            android:layout_marginHorizontal="@dimen/spacing4"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <com.example.eldercare.util.component.textfield.ElderCareEditText
            android:id="@+id/et_input_device_location"
            style="@style/TextAppearance.Body4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:customIcon="@drawable/ic_clear_21x20dp"
            android:layout_marginTop="@dimen/spacing3"
            android:layout_marginHorizontal="@dimen/spacing4"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/include_input_device_location_view_title_with_cg" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>
