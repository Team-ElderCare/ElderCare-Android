<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/rectangle_radius_16dp"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <ImageView
        android:id="@+id/iv_connected_device"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="@string/device_manage_item_image_content_description"
        android:paddingVertical="@dimen/spacing6"
        android:paddingHorizontal="54dp"
        android:background="@drawable/rectangle_radius_12dp"
        android:layout_marginTop="@dimen/spacing3"
        android:layout_marginStart="@dimen/spacing3"
        android:layout_marginEnd="@dimen/spacing3"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_place_connected_device"
        style="@style/TextAppearance.Title6"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:layout_marginTop="@dimen/spacing3"
        app:layout_constraintStart_toStartOf="@+id/iv_connected_device"
        app:layout_constraintTop_toBottomOf="@+id/iv_connected_device" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_edit_connected_device"
        style="@style/Theme.ElderCare.Button.Edit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        app:layout_constraintCircleRadius="40dp"
        android:backgroundTint="@color/ash_khaki_50"
        android:text="편집"
        app:layout_constraintEnd_toEndOf="@+id/iv_connected_device"
        app:layout_constraintTop_toBottomOf="@+id/iv_connected_device" />

    <TextView
        android:id="@+id/tv_place_location_title_connected_device"
        style="@style/TextAppearance.Body2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/device_manage_place_location"
        android:textColor="@color/Gray700"
        android:layout_marginTop="@dimen/spacing2"
        app:layout_constraintStart_toStartOf="@+id/tv_place_connected_device"
        app:layout_constraintTop_toBottomOf="@+id/tv_place_connected_device" />
    <TextView
        android:id="@+id/tv_place_location_connected_device"
        style="@style/TextAppearance.Body2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="@color/Gray700"
        app:layout_constraintStart_toEndOf="@+id/tv_place_location_title_connected_device"
        app:layout_constraintTop_toTopOf="@+id/tv_place_location_title_connected_device" />

    <TextView
        android:id="@+id/tv_device_type_title_connected_device"
        style="@style/TextAppearance.Body2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing1"
        android:text="@string/device_manage_device_type"
        android:textColor="@color/Gray700"
        android:layout_marginBottom="@dimen/spacing3"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@+id/tv_place_location_title_connected_device"
        app:layout_constraintTop_toBottomOf="@+id/tv_place_location_title_connected_device" />
    <TextView
        android:id="@+id/tv_device_type_connected_device"
        style="@style/TextAppearance.Body2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="@color/Gray700"
        app:layout_constraintStart_toEndOf="@+id/tv_device_type_title_connected_device"
        app:layout_constraintTop_toTopOf="@+id/tv_device_type_title_connected_device" />

</androidx.constraintlayout.widget.ConstraintLayout>
