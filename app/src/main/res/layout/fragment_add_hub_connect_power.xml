<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/gl_add_hub_connect_power_vertical"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.5" />

    <TextView
        android:id="@+id/tv_add_hub_connect_power_process_first"
        style="@style/TextAppearance.Title6"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/add_hub_process_second"
        android:textColor="@color/Gray900"
        android:layout_marginStart="@dimen/spacing4"
        android:layout_marginTop="@dimen/spacing9"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_add_hub_connect_power_process_all"
        style="@style/TextAppearance.SubTitle2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/add_hub_process_all"
        android:textColor="@color/Gray300"
        android:layout_marginStart="6dp"
        app:layout_constraintStart_toEndOf="@id/tv_add_hub_connect_power_process_first"
        app:layout_constraintTop_toTopOf="@id/tv_add_hub_connect_power_process_first"
        app:layout_constraintBottom_toBottomOf="@id/tv_add_hub_connect_power_process_first" />

    <TextView
        android:id="@+id/tv_add_hub_connect_power_title"
        style="@style/TextAppearance.Title1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing4"
        android:layout_marginTop="@dimen/spacing3"
        android:text="@string/connect_to_power_title"
        android:textColor="@color/Gray800"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_add_hub_connect_power_process_first" />

    <TextView
        android:id="@+id/tv_add_hub_connect_power_desc"
        style="@style/TextAppearance.SubTitle2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing3"
        android:text="@string/connect_to_power_desc"
        android:textColor="@color/Gray800"
        android:layout_marginStart="@dimen/spacing4"
        android:layout_marginEnd="42dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_add_hub_connect_power_title" />

    <ImageView
        android:id="@+id/iv_add_hub_connect_power_image"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="56dp"
        android:src="@drawable/ic_install_hub_guide_connect_power"
        android:contentDescription="@string/add_power_guide_image_content_description"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_add_hub_connect_power_desc" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_add_hub_connect_power_previous"
        style="@style/Theme.ElderCare.Button.Capsule"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/white"
        android:text="@string/input_name_previous_btn"
        android:textAppearance="@style/TextAppearance.SubTitle5"
        android:textColor="@color/primary"
        android:singleLine="true"
        android:paddingVertical="@dimen/padding_m"
        android:layout_marginStart="@dimen/spacing4"
        android:layout_marginEnd="6dp"
        android:layout_marginBottom="@dimen/spacing4"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/gl_add_hub_connect_power_vertical"
        app:layout_constraintStart_toStartOf="parent"
        app:strokeColor="@color/primary"
        app:strokeWidth="1dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_add_hub_connect_power_next"
        style="@style/Theme.ElderCare.Button.L"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/primary"
        android:text="@string/input_name_next_btn"
        android:textAppearance="@style/TextAppearance.SubTitle5"
        android:textColor="@color/white"
        android:singleLine="true"
        android:paddingVertical="@dimen/padding_m"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="@dimen/spacing4"
        android:layout_marginBottom="@dimen/spacing4"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/gl_add_hub_connect_power_vertical" />


</androidx.constraintlayout.widget.ConstraintLayout>
