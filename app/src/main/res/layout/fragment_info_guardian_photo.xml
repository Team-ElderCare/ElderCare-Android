<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingHorizontal="@dimen/padding_m">

    <TextView
        android:id="@+id/tv_info_guardian_photo"
        style="@style/TextAppearance.Title2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="100dp"
        android:text="@string/info_guardian_photo_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/iv_profile_image"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_marginTop="70dp"
        android:contentDescription="@string/info_guardian_photo_user_profile_description"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_default_profile_80dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_info_guardian_photo" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_register_photo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_l"
        android:backgroundTint="@color/ash_khaki_100"
        android:paddingHorizontal="10dp"
        android:text="@string/info_guardian_photo_image_apply_btn_info"
        android:textColor="@color/black"
        app:icon="@drawable/ic_camera_24dp"
        app:iconGravity="textStart"
        app:iconPadding="@dimen/padding_xs"
        app:iconTint="@color/black"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/iv_profile_image" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/gl_info_vertical"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.5" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_add_success_previous"
        style="@style/Theme.ElderCare.Button.Capsule"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_m"
        android:layout_marginEnd="6dp"
        android:layout_marginBottom="@dimen/margin_m"
        android:backgroundTint="@color/white"
        android:paddingVertical="@dimen/padding_m"
        android:singleLine="true"
        android:text="@string/button_text_previous"
        android:textAppearance="@style/TextAppearance.SubTitle5"
        android:textColor="@color/primary"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/gl_info_vertical"
        app:layout_constraintStart_toStartOf="parent"
        app:strokeColor="@color/primary"
        app:strokeWidth="1dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_add_success_next"
        style="@style/Theme.ElderCare.Button.L"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="@dimen/margin_m"
        android:layout_marginBottom="@dimen/margin_m"
        android:backgroundTint="@color/primary"
        android:paddingVertical="@dimen/padding_m"
        android:singleLine="true"
        android:text="@string/button_text_next"
        android:textAppearance="@style/TextAppearance.SubTitle5"
        android:textColor="@color/white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/gl_info_vertical" />
</androidx.constraintlayout.widget.ConstraintLayout>
