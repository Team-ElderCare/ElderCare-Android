<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">

    <!-- NestedScrollView로 제목부터 연락처 추가 버튼까지 감쌈 -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/nestedScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@+id/ll_navigation_buttons"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- 내부 ConstraintLayout: 스크롤 가능한 콘텐츠 영역 -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/inner_cl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            tools:context=".RunFragment">

            <!-- 제목 -->
            <TextView
                android:id="@+id/tv_input_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="56dp"
                android:layout_marginBottom="8dp"
                android:text="보호 대상자와의 관계를 선택해주세요."
                android:textSize="18sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tv_side_info"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="24dp"
                android:text="@string/ward_emergency_side_info"
                android:visibility="gone"
                app:layout_constraintTop_toBottomOf="@id/tv_input_title"
                tools:visibility="visible" />

            <!-- 기본 연락처 입력 -->
            <com.example.eldercare.presentation.ui.custom.CustomEditText
                android:id="@+id/et_primary_contact"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="8dp"
                android:inputType="number"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_side_info" />

            <LinearLayout
                android:id="@+id/ll_additional_contacts"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="10dp"
                android:orientation="vertical"
                android:visibility="invisible"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/et_primary_contact"
                tools:visibility="visible">

                <com.example.eldercare.presentation.ui.custom.CustomEditText
                    android:id="@+id/et_additional_contact_1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:inputType="number"
                    android:visibility="gone"
                    app:customHint="ex)01012345678" />

                <com.example.eldercare.presentation.ui.custom.CustomEditText
                    android:id="@+id/et_additional_contact_2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:inputType="number"
                    android:visibility="gone"
                    app:customHint="ex)01012345678" />

                <com.example.eldercare.presentation.ui.custom.CustomEditText
                    android:id="@+id/et_additional_contact_3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:inputType="number"
                    android:visibility="gone"
                    app:customHint="ex)01012345678"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tv_side_info" />

                <com.example.eldercare.presentation.ui.custom.CustomEditText
                    android:id="@+id/et_additional_contact_4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:inputType="number"
                    android:visibility="gone"
                    app:customHint="ex)01012345678"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tv_side_info" />
            </LinearLayout>

            <!-- 연락처 추가 버튼 -->
            <Button
                android:id="@+id/btn_add_contact"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="8dp"
                android:layout_marginTop="10dp"
                android:text="+ 추가하기"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/ll_additional_contacts" />

            <!-- 이미지 등록 영역 -->
            <ImageView
                android:id="@+id/iv_profile_image"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_marginTop="70dp"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_default_profile_80dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_input_title" />

            <!-- 사진 등록 버튼 -->
            <Button
                android:id="@+id/btn_register_photo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:backgroundTint="@color/ash_khaki_100"
                android:drawableStart="@drawable/ic_camera_24dp"
                android:drawablePadding="8dp"
                android:text="사진 등록"
                android:textColor="@color/black"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/iv_profile_image"
                tools:visibility="gone" />


            <!-- 관계 선택 버튼 -->
            <Button
                android:id="@+id/btn_parent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="부모"
                app:layout_constraintTop_toBottomOf="@id/tv_input_title" />

            <Button
                android:id="@+id/btn_child"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="자식" />

            <Button
                android:id="@+id/btn_sibling"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="형제" />

            <Button
                android:id="@+id/btn_cousin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="사촌" />

            <Button
                android:id="@+id/btn_friend"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="친구" />

            <Button
                android:id="@+id/btn_caregiver"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="간병인" />

            <Button
                android:id="@+id/btn_other"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="기타" />

            <!-- Flow for dynamic arrangement -->
            <androidx.constraintlayout.helper.widget.Flow
                android:id="@+id/flow_relationship_buttons"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:constraint_referenced_ids="btn_parent,btn_child,btn_sibling,btn_cousin,btn_friend,btn_caregiver,btn_other"
                app:flow_horizontalGap="8dp"
                app:flow_maxElementsWrap="4"
                app:flow_verticalGap="8dp"
                app:flow_wrapMode="chain"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_input_title" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
    <!-- 이전/다음 버튼 -->
    <LinearLayout
        android:id="@+id/ll_navigation_buttons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <Button
            android:id="@+id/btn_previous"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="이전으로" />

        <Space
            android:layout_width="16dp"
            android:layout_height="wrap_content" />

        <Button
            android:id="@+id/btn_next"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:enabled="false"
            android:text="다음으로" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
