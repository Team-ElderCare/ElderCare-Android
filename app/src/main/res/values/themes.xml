<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.ElderCare" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:statusBarColor">@color/white</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:windowBackground">@color/white</item>
    </style>

    <style name="Theme.ElderCare" parent="Base.Theme.ElderCare" />

    <style name="Theme.ElderCare.TimePickerDialog" parent="ThemeOverlay.MaterialComponents.TimePicker">
        <item name="materialClockStyle">@style/AppTheme.Widget.TimePicker.Clock</item>
        <item name="chipStyle">@style/BaseTheme.Widget.Chip</item>
        <item name="materialTimePickerTitleStyle">@style/TextAppearance.AppCompat.Medium</item>
        <item name="colorSurface">@color/white</item>
        <item name="colorPrimary">@color/Gray600</item>
        <item name="materialButtonOutlinedStyle">@style/AppTheme.Widget.TimePicker.Clock.AmPmButton</item>
    </style>

    <!--    TimePicker Display style-->
    <style name="BaseTheme.Widget.Chip" parent="Widget.MaterialComponents.TimePicker.Display">
        <item name="android:textAppearance">@style/TextAppearance.AppCompat.Medium</item>
        <item name="android:textColor">@color/selector_text_chip</item>
        <item name="strokeColor">@color/selector_stroke_chip</item>
        <item name="chipBackgroundColor">@color/selector_time_picker_button</item>
    </style>


    <!--    Clock style-->
    <style name="AppTheme.Widget.TimePicker.Clock" parent="Widget.MaterialComponents.TimePicker.Clock">
        <item name="clockFaceBackgroundColor">@color/Brown50</item>
        <item name="clockNumberTextColor">@color/selector_text_chip</item>
        <item name="clockHandColor">@color/Brown500</item>
    </style>


    <!--    AM/PM Button style-->
    <style name="AppTheme.Widget.TimePicker.Clock.AmPmButton" parent="Widget.MaterialComponents.TimePicker.Button">
        <item name="backgroundTint">@color/selector_selector_chip</item>
        <item name="strokeColor">@color/Gray400</item>
        <item name="android:textColor">@color/Gray700</item>
    </style>




    <!-- Corner size -->
    <style name="ShapeAppearanceOverlay.App.CornerSize50Percent" parent="">
        <item name="cornerSize">50%</item>
    </style>

    <!-- Base button style for all buttons -->
    <style name="Theme.ElderCare.Button.Base" parent="Widget.Material3.Button">
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textAppearance">@style/TextAppearance.SubTitle1</item>
    </style>

    <!-- delete/cancel button -->
    <style name="Theme.ElderCare.Button.Square" parent="Theme.ElderCare.Button.Base">
        <item name="android:width">118.5dp</item>
        <item name="android:height">49dp</item>
        <item name="cornerRadius">@dimen/radius_m</item>
        <item name="strokeColor">@color/primary</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:backgroundTint">@color/selector_square_btn_color</item>
        <item name="android:textColor">@color/selector_square_btn_text_color</item>
    </style>

    <!-- Base style for all capsule buttons -->
    <style name="Theme.ElderCare.Button.Capsule.Base" parent="Theme.ElderCare.Button.Base">
        <item name="android:width">328dp</item>
        <item name="android:height">55dp</item>
        <item name="cornerRadius">@dimen/padding_2xl</item>
    </style>

    <!-- capsule button -->
    <style name="Theme.ElderCare.Button.Capsule" parent="Theme.ElderCare.Button.Capsule.Base">
        <item name="android:backgroundTint">@color/selector_capsule_btn_color</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <!-- Secondary2 capsule button -->
    <style name="Theme.ElderCare.Button.Secondary2.Capsule" parent="Theme.ElderCare.Button.Capsule.Base">
        <item name="android:backgroundTint">@color/secondary_02</item>
        <item name="android:textColor">@color/primary</item>
    </style>

    <!-- Base style for mini capsule buttons -->
    <style name="Theme.ElderCare.Button.Mini.Capsule.Base" parent="Theme.ElderCare.Button.Capsule.Base">
        <item name="android:width">158dp</item>
        <item name="android:height">55dp</item>
    </style>

    <!-- mini capsule button -->
    <style name="Theme.ElderCare.Button.Mini.Capsule" parent="Theme.ElderCare.Button.Mini.Capsule.Base">
        <item name="android:backgroundTint">@color/selector_capsule_btn_color</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <!-- mini transparent capsule button -->
    <style name="Theme.ElderCare.Button.Mini.Transparent.Capsule" parent="Theme.ElderCare.Button.Mini.Capsule.Base">
        <item name="android:backgroundTint">@android:color/transparent</item>
        <item name="android:textColor">@color/primary</item>
        <item name="strokeColor">@color/primary</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- add device button -->
    <style name="Theme.ElderCare.Button.Add.Device" parent="Theme.ElderCare.Button.Base">
        <item name="android:width">100dp</item>
        <item name="android:height">32dp</item>
        <item name="cornerRadius">@dimen/padding_m</item>
        <item name="android:backgroundTint">@color/primary</item>
        <item name="android:textColor">@color/white</item>
    </style>

</resources>
