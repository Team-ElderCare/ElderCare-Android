<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.ElderCare" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:statusBarColor">@color/white</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:windowBackground">@color/white</item>
    </style>

    <style name="Theme.ElderCare" parent="Base.Theme.ElderCare" />

    <style name="Theme.ElderCare.TimePickerDialog" parent="ThemeOverlay.MaterialComponents.TimePicker">
        <item name="materialClockStyle">@style/AppTheme.Widget.TimePicker.Clock</item>
        <item name="chipStyle">@style/BaseTheme.Widget.Chip</item>
        <item name="materialTimePickerTitleStyle">@style/TextAppearance.AppCompat.Medium</item>
        <item name="colorSurface">@color/white</item>
        <item name="colorPrimary">@color/Gray600</item>
        <item name="materialButtonOutlinedStyle">@style/AppTheme.Widget.TimePicker.Clock.AmPmButton</item>
    </style>

    <!--    TimePicker Display style-->
    <style name="BaseTheme.Widget.Chip" parent="Widget.MaterialComponents.TimePicker.Display">
        <item name="android:textAppearance">@style/TextAppearance.AppCompat.Medium</item>
        <item name="android:textColor">@color/selector_text_chip</item>
        <item name="strokeColor">@color/selector_stroke_chip</item>
        <item name="chipBackgroundColor">@color/selector_time_picker_button</item>
    </style>

    <!--    Clock style-->
    <style name="AppTheme.Widget.TimePicker.Clock" parent="Widget.MaterialComponents.TimePicker.Clock">
        <item name="clockFaceBackgroundColor">@color/Brown50</item>
        <item name="clockNumberTextColor">@color/selector_text_chip</item>
        <item name="clockHandColor">@color/Brown500</item>
    </style>

    <!--    AM/PM Button style-->
    <style name="AppTheme.Widget.TimePicker.Clock.AmPmButton" parent="Widget.MaterialComponents.TimePicker.Button">
        <item name="backgroundTint">@color/selector_selector_chip</item>
        <item name="strokeColor">@color/Gray400</item>
        <item name="android:textColor">@color/Gray700</item>
    </style>

    <!--  chip style-->
    <style name="CustomChipChoice" parent="@style/Widget.MaterialComponents.Chip.Filter">
        <item name="chipBackgroundColor">@color/selector_selector_chip</item>
        <item name="android:textColor">@color/selector_text_chip</item>
        <item name="strokeColor">@color/selector_stroke_chip</item>
        <item name="android:textAppearance">@style/TextAppearance.Body6</item>
    </style>

    <!-- Corner size -->
    <style name="ShapeAppearanceOverlay.App.CornerSize50Percent" parent="">
        <item name="cornerSize">50%</item>
    </style>

    <!-- Base button style for all buttons -->
    <style name="Theme.ElderCare.Button.Base" parent="Widget.Material3.Button">
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textAppearance">@style/TextAppearance.SubTitle1</item>
    </style>

    <!-- delete/cancel button -->
    <style name="Theme.ElderCare.Button.Square" parent="Theme.ElderCare.Button.Base">
        <item name="android:width">118dp</item>
        <item name="android:height">49dp</item>
        <item name="cornerRadius">@dimen/radius_m</item>
        <item name="strokeColor">@color/primary</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:backgroundTint">@color/selector_square_btn_color</item>
        <item name="android:textColor">@color/selector_square_btn_text_color</item>
    </style>

    <!-- Base style for all capsule buttons -->
    <style name="Theme.ElderCare.Button.Capsule.Base" parent="Theme.ElderCare.Button.Base">
        <item name="android:width">328dp</item>
        <item name="android:height">55dp</item>
        <item name="cornerRadius">@dimen/padding_2xl</item>
        <item name="android:textAppearance">@style/TextAppearance.SubTitle5</item>
    </style>

    <!-- capsule button -->
    <style name="Theme.ElderCare.Button.Capsule" parent="Theme.ElderCare.Button.Capsule.Base">
        <item name="android:backgroundTint">@color/selector_capsule_btn_color</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <!-- Secondary2 capsule button -->
    <style name="Theme.ElderCare.Button.Secondary2.Capsule" parent="Theme.ElderCare.Button.Capsule.Base">
        <item name="android:backgroundTint">@color/secondary_02</item>
        <item name="android:textColor">@color/primary</item>
    </style>

    <!-- Base style for mini capsule buttons -->
    <style name="Theme.ElderCare.Button.Mini.Capsule.Base" parent="Theme.ElderCare.Button.Capsule.Base">
        <item name="android:width">158dp</item>
        <item name="android:height">55dp</item>
    </style>

    <!-- mini capsule button -->
    <style name="Theme.ElderCare.Button.Mini.Capsule" parent="Theme.ElderCare.Button.Mini.Capsule.Base">
        <item name="android:backgroundTint">@color/selector_capsule_btn_color</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <!-- mini transparent capsule button -->
    <style name="Theme.ElderCare.Button.Mini.Transparent.Capsule" parent="Theme.ElderCare.Button.Mini.Capsule.Base">
        <item name="android:backgroundTint">@android:color/transparent</item>
        <item name="android:textColor">@color/primary</item>
        <item name="strokeColor">@color/primary</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- add device button -->
    <style name="Theme.ElderCare.Button.Add.Device" parent="Theme.ElderCare.Button.Base">
        <item name="android:width">100dp</item>
        <item name="android:height">32dp</item>
        <item name="cornerRadius">@dimen/padding_m</item>
        <item name="android:backgroundTint">@color/primary</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textAppearance">@style/TextAppearance.Body3</item>
    </style>

    <!-- Button M -->
    <style name="Theme.ElderCare.Button.M" parent="Theme.ElderCare.Button.Base">
        <item name="android:backgroundTint">@color/selector_m_btn_color</item>
        <item name="android:textColor">@color/black</item>
        <item name="strokeColor">@color/selector_m_btn_stroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:textAppearance">@style/TextAppearance.SubTitle4</item>
    </style>

    <!-- Base Chip Style -->
    <style name="Theme.ElderCare.Chip" parent="Widget.MaterialComponents.Chip.Choice">
        <item name="android:stateListAnimator">@null</item>
        <item name="chipMinTouchTargetSize">0dp</item>
        <item name="chipEndPadding">0dp</item>
        <item name="chipStartPadding">0dp</item>
        <item name="android:checked">false</item>
        <item name="chipMinHeight">0dp</item>
        <item name="rippleColor">@android:color/transparent</item>
    </style>

    <!-- Chip S No Fill -->
    <style name="Theme.ElderCare.Chip.S.No.Fill" parent="Theme.ElderCare.Chip">
        <item name="cornerRadius">@dimen/padding_m</item>
        <item name="textStartPadding">10dp</item>
        <item name="textEndPadding">10dp</item>
        <item name="android:paddingVertical">4dp</item>
        <item name="chipBackgroundColor">@color/selector_chip_no_fill_background</item>
        <item name="android:textColor">@color/selector_chip_no_fill_text_color</item>
        <item name="chipStrokeColor">@color/selector_chip_no_fill_stroke</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="android:clickable">false</item>
        <item name="android:textAppearance">@style/TextAppearance.Body5</item>
    </style>

    <!-- Chip S Fill -->
    <style name="Theme.ElderCare.Chip.S.Fill" parent="Theme.ElderCare.Chip">
        <item name="cornerRadius">@dimen/padding_m</item>
        <item name="textStartPadding">10dp</item>
        <item name="textEndPadding">10dp</item>
        <item name="android:paddingVertical">4dp</item>
        <item name="chipBackgroundColor">@color/selector_chip_fill_background</item>
        <item name="android:textColor">@color/selector_chip_fill_text_color</item>
        <item name="chipStrokeColor">@color/selector_chip_fill_stroke</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="android:clickable">false</item>
        <item name="android:textAppearance">@style/TextAppearance.Body3</item>
    </style>

    <!-- Chip S No Fill -->
    <style name="Theme.ElderCare.Chip.L.No.Fill" parent="Theme.ElderCare.Chip">
        <item name="cornerRadius">@dimen/padding_m</item>
        <item name="textStartPadding">@dimen/padding_xs</item>
        <item name="textEndPadding">@dimen/padding_xs</item>
        <item name="android:paddingVertical">@dimen/padding_s</item>
        <item name="chipBackgroundColor">@color/selector_chip_no_fill_background</item>
        <item name="android:textColor">@color/selector_chip_no_fill_text_color</item>
        <item name="chipStrokeColor">@color/selector_chip_no_fill_stroke</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="android:clickable">false</item>
        <item name="android:textAppearance">@style/TextAppearance.Body2</item>
    </style>

    <!-- Chip S Fill -->
    <style name="Theme.ElderCare.Chip.L.Fill" parent="Theme.ElderCare.Chip">
        <item name="cornerRadius">@dimen/padding_m</item>
        <item name="textStartPadding">@dimen/padding_xs</item>
        <item name="textEndPadding">@dimen/padding_xs</item>
        <item name="android:paddingVertical">@dimen/padding_s</item>
        <item name="chipBackgroundColor">@color/selector_chip_fill_background</item>
        <item name="android:textColor">@color/selector_chip_fill_text_color</item>
        <item name="chipStrokeColor">@color/selector_chip_fill_stroke</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="android:clickable">false</item>
        <item name="android:textAppearance">@style/TextAppearance.Body1</item>
    </style>

    <!-- Chip Day -->
    <style name="Theme.ElderCare.Chip.Day" parent="Theme.ElderCare.Chip">
        <item name="cornerRadius">50dp</item>
        <item name="textStartPadding">@dimen/padding_s</item>
        <item name="textEndPadding">@dimen/padding_s</item>
        <item name="android:paddingVertical">@dimen/padding_s</item>
        <item name="chipBackgroundColor">@color/selector_chip_day_background</item>
        <item name="android:textColor">@color/Green600</item>
        <item name="chipStrokeColor">@color/selector_chip_no_fill_stroke</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="android:clickable">false</item>
        <item name="android:textAppearance">@style/TextAppearance.SubTitle3</item>
    </style>

    <!-- edit button -->
    <style name="Theme.ElderCare.Button.Edit" parent="Theme.ElderCare.Button.Base">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingHorizontal">@dimen/spacing2</item>
        <item name="android:paddingVertical">@dimen/spacing1</item>
        <item name="backgroundTint">@color/ash_khaki_50</item>
        <item name="android:textColor">@color/primary</item>
        <item name="android:textAppearance">@style/TextAppearance.Caption2</item>
        <item name="icon">@drawable/ic_edit_25dp</item>
        <item name="iconPadding">@dimen/spacing1</item>
        <item name="iconSize">16dp</item>
        <item name="iconTint">@color/primary</item>
        <item name="iconGravity">textStart</item>
    </style>

    <!--splash theme-->
    <style name="SplashTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="windowNoTitle">true</item>
        <item name="windowActionBar">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowIsTranslucent">true</item>
    </style>
</resources>
