<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- <attr>을 묶어 한번에 관리하기 위한 태그 -->
    <declare-styleable name="CustomButton">
        <!-- attr 태그 하나가 속성 하나를 정의 -->
        <!-- name은 레이아웃 XML에서 사용하고자 하는 속성명, format은 속성값의 타입 -->
        <attr name="customButtonTextView" format="string" />
        <attr name="customButtonIcon" format="reference" />
    </declare-styleable>

    <declare-styleable name="CustomTextField">
        <attr name="customHint" format="string" />
        <attr name="customIcon" format="reference" />
        <attr name="clearButtonEnabled" format="boolean" />
        <attr name="customUnit" format="string" />
        <attr name="isPhoneNumber" format="boolean" />
    </declare-styleable>
    <declare-styleable name="CustomWeekTextView">
        <attr name="customWeekDate" format="string"/>
        <attr name="customWeekDayOfWeek" format="string"/>
    </declare-styleable>

</resources>
